PORT=8000

# Основная конфигурация Amvera GPT (см. docs.amvera.ru/applications/configuration/variables.html)
AI_MODE=cloud
CLOUD_API_URL=https://kong-proxy.yc.amvera.ru/api/v1
CLOUD_API_KEY=replace-me
CLOUD_MODEL=gpt-5
CLOUD_TIMEOUT=20

# Если понадобится переключить поставщика, раскомментируйте нужный блок ниже.

