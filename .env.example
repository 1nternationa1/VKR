PORT=8000

# Основная конфигурация Amvera GPT (см. docs.amvera.ru/applications/configuration/variables.html)
AI_MODE=cloud
CLOUD_API_URL=https://kong-proxy.yc.amvera.ru/api/v1
CLOUD_API_KEY=your-cloud-api-key
CLOUD_MODEL=gpt-5
CLOUD_TIMEOUT=20

# --- Proxy (optional) ---
# HTTP_PROXY=http://user:pass@host:port
# HTTPS_PROXY=http://user:pass@host:port
# Global HTTP(S)_PROXY are used only in listing fallback flow.
# CLOUD_HTTP_PROXY=
# CLOUD_HTTPS_PROXY=
# GEMINI_HTTP_PROXY=
# GEMINI_HTTPS_PROXY=
# LISTING_HTTP_PROXY=
# LISTING_HTTPS_PROXY=
# LISTING_PLAYWRIGHT_HEADLESS=false
# LISTING_AVITO_PLAYWRIGHT_FIRST=true
# LISTING_PLAYWRIGHT_CHANNEL=chrome
# LISTING_PLAYWRIGHT_STORAGE_STATE=data/playwright_avito_state.json
# LISTING_CAPTCHA_WAIT_SECONDS=90

# Если понадобится переключить поставщика, раскомментируйте нужный блок ниже.

# --- Gemini ---
# AI_MODE=gemini
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL_FALLBACK=gemini-1.5-flash-latest
# GEMINI_API_URL=
# GEMINI_TIMEOUT=20
# GEMINI_TEMPERATURE=0.25

# --- OpenAI ---
# AI_MODE=cloud
# CLOUD_API_URL=https://api.openai.com/v1/chat/completions
# CLOUD_API_KEY=sk-***
# CLOUD_MODEL=gpt-4o-mini
# CLOUD_MODEL_FALLBACK=gpt-3.5-turbo-0125
# CLOUD_TIMEOUT=20
