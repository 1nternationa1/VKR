PORT=8000
AI_MODE=gemini          # gemini | cloud | stub

# Gemini (по умолчанию)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-1.5-flash-latest
# GEMINI_API_URL=              # опционально, если нужен кастомный эндпоинт
GEMINI_TIMEOUT=20
GEMINI_TEMPERATURE=0.25

# OpenAI (опционально, если вернётесь к GPT)
# CLOUD_API_URL=https://api.openai.com/v1/chat/completions
# CLOUD_API_KEY=sk-***
# CLOUD_MODEL=gpt-4o-mini
# CLOUD_MODEL_FALLBACK=gpt-3.5-turbo-0125
# CLOUD_TIMEOUT=20
